    },
    {
      "id": "greeting-dry",
      "text": "Welcome aboard. I know this portfolio. The rest of the universe remains outside my job description.",
      "src": "assets/audio/tars/greeting-dry.mp3",
      "durationSeconds": 7.84,
      "bytes": 63479,
