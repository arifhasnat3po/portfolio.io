      "channels": 1,
      "peakDbFS": -2.38
    },
    {
      "id": "greeting-mischievous",
      "text": "Welcome aboard. I handle navigation. You handle pretending that the robot is not your favorite part.",
      "src": "assets/audio/tars/greeting-mischievous.mp3",
      "durationSeconds": 7.71,
      "bytes": 62527,
